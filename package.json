{
  "name": "nexus-ai-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "NEXUS AI monorepo structure for NestJS, Next.js, Flutter, and Python AI services. Documentation-only skeleton generated from the NEXUS AI platform specification.",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/platform-services/*"
  ],
  "scripts": {
    "dev": "turbo dev --concurrency=20",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{md,json,yml,yaml}\"",
    "docs:check": "echo \"Documentation-only skeleton: add markdown linting later\"",
    "dashboard": "node health-dashboard.js",
    "start:all": "concurrently \"pnpm run dev\" \"pnpm run dashboard\"",
    "api:dev": "pnpm --filter @nexus/api dev",
    "web:dev": "pnpm --filter @nexus/web dev",
    "admin:dev": "pnpm --filter @nexus/admin dev",
    "mobile:dev": "echo \"Run Flutter commands inside apps/mobile when Flutter project is initialized\"",
    "ai:dev": "echo \"Run Python AI services individually when their pyproject files are added\""
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.27",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "concurrently": "^10.0.3",
    "jest": "^30.4.2",
    "pdf-parse": "^2.4.5",
    "prettier": "latest",
    "ts-jest": "^29.4.11",
    "turbo": "latest"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.27",
    "@nestjs/platform-socket.io": "^11.1.27",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.27",
    "axios": "^1.18.1",
    "jsonwebtoken": "^9.0.3",
    "socket.io": "^4.8.3"
  }
}