# ─────────────────────────────────────────────────
# NEXUS AI Life Orchestrator — Environment Configuration
# ─────────────────────────────────────────────────

# Service
PORT=4700
HOST=0.0.0.0
ENV=local

# Downstream services
AI_MODEL_ROUTER_URL=http://localhost:4703
AUDIT_SERVICE_URL=http://localhost:4109
REQUEST_TIMEOUT_SEC=10.0

# Background inference loop (PDF: every 15 minutes = 900s)
ORCHESTRATION_INTERVAL_SEC=900
ENABLE_SCHEDULER=true

# Signal windows
SIGNAL_FRESHNESS_SEC=86400
LIFE_STATE_HISTORY=96

# Priority engine
PRIORITY_URGENCY_WEIGHT=0.45
PRIORITY_IMPORTANCE_WEIGHT=0.35
PRIORITY_READINESS_WEIGHT=0.20
STRESS_PROTECTION_THRESHOLD=0.6
